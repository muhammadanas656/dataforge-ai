# ==========================================
# DataForge AI — Environment Configuration
# ==========================================

# Primary LLM Provider: 'groq' | 'openai' | 'gemini' | 'anthropic'
api_provider=groq

# Your AI Provider API Key (e.g., Groq API key, OpenAI API key)
api_key=your_api_key_here

# Default Model Identifier
# Groq: openai/gpt-oss-20b, llama-3.3-70b-versatile, llama-3.1-8b-instant
# OpenAI: gpt-4o-mini, gpt-4o, o3-mini
# Gemini: gemini-2.5-flash
# Anthropic: claude-3-5-sonnet-20241022
api_model=openai/gpt-oss-20b

# Frontend -> Backend Connection Endpoint (for Vercel / Cloud Deployments)
NEXT_PUBLIC_API_URL=http://localhost:8000
